{
    "name": "silvercommerce/payments-stripe-paymentintents",
    "description": "Package that adds Stripe payments (via omnipay) and includes Payment Intent integration",
      "type": "silverstripe-vendormodule",
      "homepage": "https://github.com/silvercommerce/payments-stripe-paymentintents",
      "keywords": [
          "silverstripe",
          "commerce",
          "ecommerce",
          "payments",
          "omnipay",
          "stripe"
      ],
      "license": "BSD-3-Clause",
      "authors": [
          {
              "name": "Dean Forest Tech",
              "homepage": "https://dean-forest-tech.uk"
          }
      ],
      "support": {
          "issues": "https://github.com/silvercommerce/payments-stripe-paymentintents/issues"
      },
      "require": {
          "silverstripe/framework": "^4 || ^5",
          "silvercommerce/checkout": "^1",
          "silvercommerce/settings": "^1",
          "silvercommerce/orders-admin": "^1",
          "omnipay/stripe": "^3"
      },
      "extra": {
          "expose": [
              "client"
          ]
      },
      "autoload": {
          "psr-4": {
              "SilverCommerce\\StripePaymentIntents\\Extensions\\": "src/"
          }
      }
  }
